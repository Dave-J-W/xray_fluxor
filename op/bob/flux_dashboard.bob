<widget type="label" version="2.0.0"><name>label_39</name><text>NO CONTACT</text><x>1022</x><y>62</y><width>138</width><height>26</height><font><font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0"></font></font><foreground_color><color name="Text" red="0" green="0" blue="0"></color></foreground_color><background_color><color red="150" green="150" blue="150"></color></background_color><transparent>false</transparent><horizontal_alignment>1</horizontal_alignment><vertical_alignment>1</vertical_alignment><wrap_words>true</wrap_words><rules><rule name="text" prop_id="text" out_exp="false"><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; (pv2 &gt; 0.5 || pv3 &gt; 0.5)"><value>ALARM</value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; pvSev0 == 3"><value>NO DATA</value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; !pvSev0 == 3 &amp;&amp; pv4 &gt; 0.5"><value>NO BEAM</value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; !pvSev0 == 3 &amp;&amp; !pv4 &gt; 0.5 &amp;&amp; (pv5 &gt; 0.5 || pv6 &gt; 0.5)"><value>WARNING</value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; !pvSev0 == 3 &amp;&amp; !pv4 &gt; 0.5 &amp;&amp; !(pv5 &gt; 0.5 || pv6 &gt; 0.5)"><value></value></exp><pv_name>$(P)userTran6.L</pv_name><pv_name>$(P)HEARTBEAT</pv_name><pv_name>$(P)userTran8.J</pv_name><pv_name>$(P)userTran8.K</pv_name><pv_name>$(P)userTran8.I</pv_name><pv_name>$(P)userTran8.G</pv_name><pv_name>$(P)userTran8.H</pv_name></rule><rule name="colour" prop_id="background_color" out_exp="false"><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; (pv2 &gt; 0.5 || pv3 &gt; 0.5)"><value><color red="255" green="60" blue="60"></color></value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; pvSev0 == 3"><value><color red="255" green="0" blue="255"></color></value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; !pvSev0 == 3 &amp;&amp; pv4 &gt; 0.5"><value><color red="190" green="190" blue="190"></color></value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; !pvSev0 == 3 &amp;&amp; !pv4 &gt; 0.5 &amp;&amp; (pv5 &gt; 0.5 || pv6 &gt; 0.5)"><value><color red="255" green="215" blue="0"></color></value></exp><exp bool_exp="pvStr1 != &quot;&quot; &amp;&amp; pvSev1 &lt; 3 &amp;&amp; !(pv2 &gt; 0.5 || pv3 &gt; 0.5) &amp;&amp; !pvSev0 == 3 &amp;&amp; !pv4 &gt; 0.5 &amp;&amp; !(pv5 &gt; 0.5 || pv6 &gt; 0.5)"><value><color red="225" green="232" blue="240"></color></value></exp><pv_name>$(P)userTran6.L</pv_name><pv_name>$(P)HEARTBEAT</pv_name><pv_name>$(P)userTran8.J</pv_name><pv_name>$(P)userTran8.K</pv_name><pv_name>$(P)userTran8.I</pv_name><pv_name>$(P)userTran8.G</pv_name><pv_name>$(P)userTran8.H</pv_name></rule></rules><tooltip>ALARM: flag 16 or 32. NO DATA: RESULT INVALID (an input link is dead). NO BEAM / LOW CURRENT: flag 8. WARNING: flag 2 or 4. Flag 1 is informational (Flags tab).</tooltip></widget>
